# ==========================================================================
#  Immich Home Media Server — конфигурация
#  Скопируй этот файл: cp .env.example .env  и поправь пути под себя.
#  ВАЖНО: все пути должны быть АБСОЛЮТНЫМИ (docker на macOS не понимает ~).
# ==========================================================================

# --------------------------------------------------------------------------
# 1. ВЫБОР ХРАНИЛИЩА
# --------------------------------------------------------------------------
# local = данные лежат на диске Mac
# ssd   = данные лежат на внешнем SSD (том в /Volumes)
STORAGE_TYPE=local

# Путь для режима local (создаётся автоматически при старте)
LOCAL_STORAGE_PATH=/Users/username/Pictures/ImmichData

# Путь для режима ssd (том должен быть смонтирован до старта)
SSD_STORAGE_PATH=/Volumes/MySSD/ImmichData

# Имя тома внешнего SSD ровно как в /Volumes (нужно для eject в stop.sh)
SSD_VOLUME_NAME=MySSD

# --------------------------------------------------------------------------
# 2. РАБОЧИЕ ПУТИ (подставляются автоматически — руками не трогать)
# --------------------------------------------------------------------------
# UPLOAD_LOCATION вычисляется скриптами scripts/*.sh на основе STORAGE_TYPE
# и экспортируется в окружение перед 'docker compose up'.
# Значение ниже — только фолбэк для случая, когда compose запускают напрямую.
UPLOAD_LOCATION=/Users/username/Pictures/ImmichData/library

# Данные PostgreSQL хранятся в ИМЕНОВАННОМ томе Docker (immich_db_local или
# immich_db_ssd — выбирается автоматически по STORAGE_TYPE). Так требует macOS:
# на bind-mount postgres не стартует. Путь в .env задавать не нужно.
# Дампы БД для бэкапа кладутся в <корень хранилища>/db-backup (make backup-db).

# --------------------------------------------------------------------------
# 3. БАЗА ДАННЫХ И ПОРТЫ
# --------------------------------------------------------------------------
DB_PASSWORD=eUXpzXYIalyWNEJFgIvItkSioPhW
DB_DATABASE_NAME=immich
DB_USERNAME=postgres
DB_HOSTNAME=database

# Порт веб-интерфейса: http://localhost:2283
IMMICH_PORT=2283

# --------------------------------------------------------------------------
# 4. ВЕРСИЯ И ЛОКАЛЬ
# --------------------------------------------------------------------------
# release = всегда последний стабильный релиз (нужен для scripts/update.sh)
IMMICH_VERSION=release
TZ=Europe/Moscow
IMMICH_LOG_LEVEL=log

# --------------------------------------------------------------------------
# 5. ЛИМИТЫ РЕСУРСОВ (легковесный режим)
#    Меняются на лету: достаточно 'make restart'.
# --------------------------------------------------------------------------
# Machine Learning — самый прожорливый сервис
ML_CPU_LIMIT=2.0
ML_MEM_LIMIT=2g
# Кол-во воркеров ML (1 = минимум нагрузки)
ML_WORKERS=1
# Выгружать модель из RAM после N секунд простоя (0 = держать всегда)
ML_MODEL_TTL=300

# Основной сервер Immich (api + фоновые джобы)
SERVER_CPU_LIMIT=2.0
SERVER_MEM_LIMIT=2g
# Потолок кучи Node.js в мегабайтах
SERVER_NODE_HEAP_MB=1536

# PostgreSQL
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=1g

# Redis / Valkey
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=256m
